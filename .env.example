# copy this file to .env

# use this instead and comment out WEB_PORT if you have PocketBase is running elsewhere:
# EXTERNAL_PB_URL=https://pb.example.com

# port the app is published on with compose (default: http://localhost:7777)
WEB_PORT=7777

# PocketBase dashboard superuser (http://localhost:7777/_/)
PB_ADMIN_EMAIL=pocketbase@admin.account
PB_ADMIN_PASSWORD=totallystrongadminpassword

# copy this to .env.dev for development and testing
# pocketbase dev url
# VITE_PB_URL=https://pb.example.com

# PocketBase dashboard superuser (http://localhost:7777/_/)
# PB_ADMIN_EMAIL=pocketbase@admin.account
# PB_ADMIN_PASSWORD=totallystrongadminpassword