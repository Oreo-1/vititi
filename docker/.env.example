# Copy to the project root as .env:  cp docker/.env.example .env  (Compose reads it automatically).

# Port the app is published on (http://localhost:8080).
WEB_PORT=8080

# PocketBase dashboard superuser (http://localhost:8080/_/).
# If left empty, create it from the install link printed in `docker compose logs pocketbase`.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-please

# PocketBase version baked into the image.
PB_VERSION=0.40.6
